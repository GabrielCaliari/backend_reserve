{
  "name": "api_zarp-admin",
  "version": "26.1.3",
  "description": "The most advanced admin panel for website management",
  "author": "Zarp Studio",
  "private": true,
  "license": "MIT",
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seeds.ts"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "postinstall": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@ai-sdk/azure": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/client-sns": "^3.848.0",
    "@bull-board/express": "^6.12.0",
    "@nestjs/bull": "^11.0.3",
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@vercel/blob": "^2.2.0",
    "ai": "^5.0.0",
    "axios": "^1.7.9",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cli-progress": "^3.12.0",
    "csv-parser": "^3.1.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^8.0.0",
    "express": "^4.21.2",
    "fast-csv": "^5.0.2",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.10",
    "marked": "^15.0.6",
    "mysql2": "^3.12.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "progress": "^2.0.3",
    "promise-streams": "^2.1.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sharp": "^0.34.5",
    "stripe": "^17.6.0",
    "throttled-queue": "^2.1.4",
    "unzipper": "^0.12.3",
    "uuidv4": "^6.2.13",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.13",
    "@types/bull": "^3.15.9",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.16.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^7.4.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
