# ===== n8n + Postgres do bot =====
# Copie para deploy/.env.bot e preencha. NUNCA versione o arquivo preenchido.

# Senha do Postgres do bot (nova e forte; so letras e numeros evita problemas).
POSTGRES_PASSWORD=
# Tem de ser IGUAL a POSTGRES_PASSWORD (o n8n usa para entrar no Postgres).
DB_POSTGRESDB_PASSWORD=

# Chave que criptografa as credenciais salvas dentro do n8n.
# TEM de ser a MESMA do ambiente local (C:\reserve-bot\.env). Outra chave = credenciais ilegiveis.
N8N_ENCRYPTION_KEY=

# Fuso horario
TZ=America/Sao_Paulo
