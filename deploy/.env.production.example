# ===== Backend Reserve (producao) =====
# Copie para deploy/.env.production e preencha. NUNCA versione o arquivo preenchido.
# Formato: CHAVE=valor (sem aspas, sem espacos em volta do "="). Se o valor tiver "$",
# coloque entre aspas simples: CHAVE='valor$com$cifrao'.
#
# ATENCAO - CHAVES DE CRIPTOGRAFIA: ENCRYPT_PRIVATE_KEY, AES_ENCRYPTION_KEY, JWT_PRIVATE_KEY e
# JWT_SECRET precisam ter EXATAMENTE os mesmos valores do .env local. Segredos ja gravados
# na Neon (tokens Stripe/Google/Meta, senhas, chaves de tenant) foram criptografados com
# elas; valores novos deixam tudo isso ilegivel e invalidam todas as senhas e sessoes.

# Porta HTTP da API dentro do container (o Caddy fala com ela; nao e publicada na internet)
PORT=3000

NODE_ENV=production

# Origens permitidas no CORS, separadas por virgula, sem barra final.
# Ex.: https://painel.reservemkt.com.br
CORS_ORIGINS=

# URL do banco do painel na Neon (Sao Paulo), terminando com ?sslmode=require.
# Use a URL "pooled" para a API. Se o migrate falhar com a pooled, use a "direct" (sem -pooler) so nele.
DATABASE_URL=

# Redis (container "redis" desta stack). Host fixo: redis. A senha e a mesma usada pelo servico redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Chaves de criptografia (iguais ao .env local!) ---
# Pepper do hash de senhas e das chaves de tenant/blog/bot
ENCRYPT_PRIVATE_KEY=
# Exatamente 32 caracteres
AES_ENCRYPTION_KEY=
# Assina/valida o JWT de sessao. Texto em UMA linha: o codigo le o valor cru (nao troca "\n").
# Com JWT_ALGORITHM=HS256 e um segredo simples; chave PEM multilinha nao e suportada como esta.
JWT_PRIVATE_KEY=
JWT_ALGORITHM=HS256
# Segredo legado: deriva a chave AES das credenciais Stripe salvas por tenant
JWT_SECRET=

# Chave interna (integracoes internas)
INTERNAL_API_KEY=

# Disparo externo dos crons do bot (POST /api/internal/cron/*, Bearer). Minimo 32 caracteres
# (gere com: openssl rand -hex 32)
CRON_SECRET=

# --- URLs ---
# URL publica do painel (links de cupom e billing)
FRONTEND_URL=https://painel.reservemkt.com.br
# Retorno do Stripe Billing Portal
USER_DASHBOARD=https://painel.reservemkt.com.br
# Retorno do Stripe Checkout
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
# Dominio publico dos links rastreados do WhatsApp (padrao no codigo: https://link.reservemkt.com.br)
# APP_URL=
# Slug do plano gratuito (padrao no codigo: free)
# FREE_PLAN_SLUG=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google (GA4 + Ads) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A mesma URL cadastrada no Google Cloud (agora com o dominio api.reservemkt.com.br)
GOOGLE_REDIRECT_URI=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta Ads ---
META_APP_ID=
META_APP_SECRET=

# --- Armazenamento ---
# Vercel Blob (uploads)
BLOB_READ_WRITE_TOKEN=
# Bucket S3-compativel do CMS (deixe vazio se nao usar)
# CMS_BUCKET_ACCESS_KEY_ID=
# CMS_BUCKET_SECRET_ACCESS_KEY=
# CMS_BUCKET_NAME=
# CMS_BUCKET_ENDPOINT=
# CMS_BUCKET_REGION=
# CMS_BUCKET_CDN_URL=
# Qualidade das imagens do CMS (1-100, padrao 80)
# CMS_IMAGE_QUALITY=

# --- Opcionais: descomente e preencha so se usar. NAO deixe a variavel vazia (vazio nao ativa o padrao do codigo). ---
# --- AWS (SES/S3/SNS) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
# AWS_SES_REGION=

# --- WhatsApp Cloud API (aviso de digest) - opcional ---
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
# WHATSAPP_DIGEST_TEMPLATE_NAME=

# --- Seguranca/diagnostico (deixe como esta em producao) ---
# Swagger so sobe em producao com "true" (documentacao publica; recomendado false)
SWAGGER_ENABLED=false
# Nunca desligue em producao
SECURITY_POSTURE_ENFORCE=true
