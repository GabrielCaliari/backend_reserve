# Application
# Porta HTTP da API
PORT=3002

# Ambiente: development | production
NODE_ENV=development

# Origens permitidas no CORS, separadas por vírgula, sem barra final
CORS_ORIGINS=http://localhost:3001

# RBAC deny-by-default (Fase 2, Task 21): enforce ligado por padrão —
# SecurityPostureGuard 403 qualquer rota sem @Public()/@UseGuards. Deixar
# SECURITY_POSTURE_ENFORCE=false apenas temporariamente, durante uma auditoria
# pontual de rotas novas; nunca em produção.

# Ativa logs verbosos do Prisma (client, query, info, warn, error) quando igual a "DEV"
AMBIENT=

# URL pública base usada para montar links de redirecionamento (ex.: WhatsApp tracking).
# Default no código: https://link.reservemkt.com.br
APP_URL=

# URL do frontend usada para montar links (ex.: cupons, config de billing).
# Default no código: http://localhost:3000
FRONTEND_URL=

# URL do dashboard do usuário, usada como retorno do Stripe Billing Portal
USER_DASHBOARD=

# Database (PostgreSQL)
DATABASE_URL=

# Redis (Bull queues + cache)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# JWT Authentication
# Segredo legado usado apenas para derivar a chave de criptografia AES-256-GCM
# das credenciais Stripe salvas em tenant-billing-config (não é usado para assinar JWT).
JWT_SECRET=

# Chave privada e algoritmo usados para assinar/verificar os JWTs de sessão (JwtProvider)
JWT_PRIVATE_KEY=
JWT_ALGORITHM=HS256

# Swagger
# Monta /api/docs em produção. Fora de produção o Swagger sempre sobe.
# Só ligue em produção se a documentação puder ser pública.
SWAGGER_ENABLED=false

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_SES_REGION=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URLs de retorno do Stripe Checkout (sucesso e cancelamento)
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Slug do plano gratuito usado como fallback ao processar webhook B2B quando
# não há plano explícito associado. Default no código: "free"
FREE_PLAN_SLUG=

# AES-256 encryption for API tokens (must be exactly 32 chars)
AES_ENCRYPTION_KEY=

# Chave privada usada como pepper no PBKDF2 das senhas (HashProvider).
# Trocar esta chave invalida TODAS as senhas existentes.
ENCRYPT_PRIVATE_KEY=

# Google OAuth (GA4 + Google Ads)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Ads (Facebook)
META_APP_ID=
META_APP_SECRET=

# PDF export (Fase 6 Task 1) — local dev only; the Vercel deployment resolves
# the Chromium binary via @sparticuz/chromium instead.
PUPPETEER_EXECUTABLE_PATH=

# WhatsApp Cloud API — digest publish notifications (Fase 6 Task 3). The
# approved template name is a Meta Business Manager artifact this repo
# cannot define; it must be created/approved before this has a real value.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_DIGEST_TEMPLATE_NAME=

# Vercel Blob (for file uploads if used)
BLOB_READ_WRITE_TOKEN=

# CMS bucket storage (S3-compatible), usado pelo ArticleImageService / MediaAssetService
CMS_BUCKET_ACCESS_KEY_ID=
CMS_BUCKET_SECRET_ACCESS_KEY=
CMS_BUCKET_NAME=
CMS_BUCKET_ENDPOINT=
CMS_BUCKET_REGION=
CMS_BUCKET_CDN_URL=

# Qualidade (1-100) aplicada na compressão de imagens enviadas ao CMS. Default no código: 80
CMS_IMAGE_QUALITY=

# Swagger / Internal
INTERNAL_API_KEY=

# Disparo externo dos crons do bot (POST /api/internal/cron/bot-sync, Bearer). Sem valor, a rota recusa tudo
CRON_SECRET=
