model Admin {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(25)
  email             String              @unique
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  AdminSessionToken AdminSessionToken[]
  AdminCredential   AdminCredential?
}

model AdminSessionToken {
  id         Int      @id @default(autoincrement())
  hash_token String
  salt       String
  admin_id   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  Admin      Admin    @relation(fields: [admin_id], references: [id])
}

model AdminCredential {
  id         Int      @id @default(autoincrement())
  admin_id   Int      @unique
  hash       String
  salt       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  Admin      Admin    @relation(fields: [admin_id], references: [id])
}

model SMSNotification {
  id                   Int                    @id @default(autoincrement())
  webhook              String                 @unique @db.VarChar(255)
  name                 String
  total_notifications  Int                    @db.SmallInt
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  SMSNotificationEvent SMSNotificationEvent[]
}

model SMSNotificationEvent {
  id                        Int             @id @default(autoincrement())
  message                   String          @db.VarChar(160)
  destination_number        String          @db.VarChar(18)
  sender_number             String          @db.VarChar(18)
  destination_country       Int             @db.SmallInt
  sms_provider              Int             @db.SmallInt
  payload_provider_response Json?
  payload_message           Json?
  status                    Int             @db.SmallInt
  SMSNotification           SMSNotification @relation(fields: [sms_notification_id], references: [id])
  sms_notification_id       Int
  created_at                DateTime        @default(now())
  updated_at                DateTime        @updatedAt
}

model Config {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model EmailCampaign {
  id                  Int             @id @default(autoincrement())
  name                String
  total_leads         Int
  open_rate           Int
  click_rate          Int
  campaign_batch_size Int?
  uploaded_leads      Boolean         @default(false)
  copy_variation_type Int?            @db.SmallInt
  funnel_campaign     Boolean         @default(false)
  main_email          Email?          @relation(fields: [main_email_id], references: [id])
  main_email_id       Int?
  status              Int             @db.SmallInt
  started_at          DateTime?
  finished_at         DateTime?
  smtp_server         SMTPServer      @relation(fields: [smtp_server_id], references: [id])
  smtp_server_id      Int
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  EmailLead           EmailLead[]
  CampaignBatch       CampaignBatch[]
}

model Email {
  id                Int             @id @default(autoincrement())
  type              Int             @db.SmallInt
  name              String
  html_content      String
  md_content        String
  used_ai           Boolean
  from_name         String          @db.VarChar(255)
  edited            Boolean         @default(false)
  subject           String          @db.VarChar(255)
  pre_header        String?         @db.VarChar(255)
  use_header        Boolean         @default(false)
  use_footer        Boolean         @default(false)
  tracking_image    String?
  prompt_tokens     Int?
  completion_tokens Int?
  total_tokens      Int?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  EmailCampaign     EmailCampaign[]
  CampaignBatch     CampaignBatch[]
  Delivery          Delivery[]
}

model Delivery {
  id                   Int             @id @default(autoincrement())
  email_lead_id        Int
  email_lead           EmailLead       @relation(fields: [email_lead_id], references: [id])
  email                Email           @relation(fields: [email_id], references: [id])
  campaign_batch_id    Int
  campaign_batch       CampaignBatch   @relation(fields: [campaign_batch_id], references: [id])
  email_id             Int
  server_response      Json?
  send_date            DateTime?
  server_response_date DateTime?
  last_open_date       DateTime?
  last_click_date      DateTime?
  clicked              Boolean         @default(false)
  opened               Boolean         @default(false)
  tracking_code        String?
  email_provider       String
  email_sent_to        String
  status               Int             @db.SmallInt
  unsubscribe          Boolean         @default(false)
  unsubscribe_date     DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  OpenTracking         OpenTracking[]
  ClickTracking        ClickTracking[]
}

model OpenTracking {
  id                Int      @id @default(autoincrement())
  delivery_id       Int
  delivery          Delivery @relation(fields: [delivery_id], references: [id])
  bot_chance        Int      @db.SmallInt
  open_date         DateTime
  request_open_json Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model ClickTracking {
  id                 Int      @id @default(autoincrement())
  delivery_id        Int
  delivery           Delivery @relation(fields: [delivery_id], references: [id])
  bot_chance         Int      @db.SmallInt
  link_clicked       String
  link_clicked_date  DateTime
  request_click_json Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model EmailLead {
  id                Int           @id @default(autoincrement())
  email             String
  EmailCampaign     EmailCampaign @relation(fields: [email_campaign_id], references: [id])
  email_campaign_id Int
  status            Int           @db.SmallInt
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  Delivery          Delivery[]
}

model CampaignBatch {
  id                Int           @id @default(autoincrement())
  total_leads       Int
  un_open_rate      Int           @default(0)
  un_click_rate     Int           @default(0)
  un_unsubscribe    Int           @default(0)
  un_success_rate   Int?
  un_failed_rate    Int?
  email_campaign    EmailCampaign @relation(fields: [email_campaign_id], references: [id])
  email_campaign_id Int
  status            Int           @db.SmallInt
  email             Email?        @relation(fields: [email_id], references: [id])
  email_id          Int?
  started_at        DateTime?
  finished_at       DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  Delivery          Delivery[]
}

model SMTPServer {
  id                 Int             @id @default(autoincrement())
  name               String          @db.VarChar(255)
  email              String          @db.VarChar(255)
  domain             String          @db.VarChar(255)
  host               String?         @db.VarChar(255)
  port               String?         @db.VarChar(255)
  username           String?         @db.VarChar(255)
  hash_password      String?
  hash_access_token  String?
  hash_private_token String?
  region             String?         @db.VarChar(255)
  provider           Int             @db.SmallInt
  default            Boolean         @default(false)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  EmailCampaign      EmailCampaign[]
}
