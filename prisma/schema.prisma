generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                      @id @default(cuid()) @db.VarChar(25)
  email                     String                      @unique
  name                      String                      @db.VarChar(100)
  cpf                       String                      @db.VarChar(11)
  phone_number              String                      @db.VarChar(13)
  sex                       Int?                        @default(1) @db.SmallInt
  date_of_birth             DateTime?                   @db.Date
  date_expires_in           DateTime?                   @db.Date
  plan_id                   String                      @db.VarChar(25)
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  stripe_customer_id        String?                     @unique @db.VarChar(100)
  Subscription              Subscription[]
  Plan                      Plan                        @relation(fields: [plan_id], references: [id])
  UserCollectionMembership  UserCollectionMembership[]
  Credential                UserCredential?
  UserPasswordChangeSession UserPasswordChangeSession[]
  UserSessionToken          UserSessionToken[]
  B2BPurchase               B2BPurchase[]
  B2CCheckoutSessions       B2CCheckoutSession[]        @relation("B2CCheckoutSessionUser")
  UserProductAccess         UserProductAccess[]
}

model Plan {
  id                        String           @id @default(cuid()) @db.VarChar(25)
  name                      String           @db.VarChar(100)
  slug                      String           @unique
  maximum_queries           Int
  maximum_queries_to_export Int              @default(0)
  maximum_brand_analysis    Int              @default(0)
  month_price_id            String?
  annual_price_id           String?
  created_at                DateTime         @default(now())
  updated_at                DateTime         @default(now()) @updatedAt
  Subscription              Subscription[]
  User                      User[]
}

model Subscription {
  id                     String    @id @default(cuid()) @db.VarChar(25)
  name                   String
  subscription_id        String    @unique
  customer_id            String
  status                 String
  string_plan_id         String
  string_plan_nickname   String?
  string_plan_amount     Int
  string_plan_currency   String
  interval               String
  start_date             DateTime
  current_period_start   DateTime
  current_period_end     DateTime
  trial_end              DateTime?
  cancel_at              DateTime?
  canceled_at            DateTime?
  ended_at               DateTime?
  billing_cycle_anchor   DateTime
  payment_method         String?
  default_payment_method String?
  auto_renew             Boolean
  quantity               Int
  tax_percent            Float?
  discount               Json?
  latest_invoice_id      String?
  next_invoice_date      DateTime?
  cancel_at_period_end   Boolean
  metadata               Json?
  created_from_webhook   Boolean
  event_history          Json?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  plan_id                String    @db.VarChar(25)
  user_id                String    @db.VarChar(25)
  Plan                   Plan      @relation(fields: [plan_id], references: [id])
  User                   User      @relation(fields: [user_id], references: [id])

  @@index([subscription_id])
  @@index([customer_id])
}

model UserSessionToken {
  id         String   @id @default(cuid()) @db.VarChar(25)
  hash_token String
  salt       String
  user_id    String   @db.VarChar(25)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  User       User     @relation(fields: [user_id], references: [id])
}

model UserCredential {
  id              String    @id @default(cuid()) @db.VarChar(25)
  user_id         String    @unique @db.VarChar(25)
  hash            String
  salt            String
  hash_version    Int       @default(1) @db.SmallInt
  failed_attempts Int       @default(0)
  locked_until    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  User            User      @relation(fields: [user_id], references: [id])
}

model UserCredentialHistory {
  id         String   @id @default(cuid()) @db.VarChar(25)
  user_id    String   @db.VarChar(25)
  hash       String
  salt       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model UserPasswordChangeSession {
  id         String    @id @default(cuid()) @db.VarChar(25)
  slug       String    @db.VarChar(64)
  status     Int       @db.SmallInt
  hash_token String
  salt       String
  lat        String?
  long       String?
  device_ip  String    @db.VarChar(16)
  expires_in DateTime
  expired_at DateTime?
  user_id    String    @db.VarChar(25)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  User       User      @relation(fields: [user_id], references: [id])
}

model Lead {
  id             String           @id @default(uuid()) @db.Uuid
  name           String?          @db.VarChar(255)
  email          String?
  phone_number   String?          @db.VarChar(14)
  origin         Int?             @db.SmallInt
  origin_font    String?          @db.VarChar(50)
  description    String?
  data           Json?
  status         Int?             @default(1) @db.SmallInt
  collection_id  String?          @db.VarChar(25)
  tenant_id      String?          @db.VarChar(25)
  ip_address     String?          @db.VarChar(45)
  user_agent     String?
  country        String?          @db.VarChar(100)
  city           String?          @db.VarChar(100)
  region         String?          @db.VarChar(100)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  Appointments   Appointment[]
  LeadCollection LeadCollection?  @relation(fields: [collection_id], references: [id])
  Tenant         Tenant?          @relation(fields: [tenant_id], references: [id])
  LeadAttachment LeadAttachment[]

  @@index([tenant_id])
  @@index([country])
  @@index([city])
  @@index([created_at])
}

model Admin {
  id                        String                      @id @default(cuid()) @db.VarChar(25)
  name                      String                      @db.VarChar(100)
  email                     String                      @unique
  role                      EAdminRole                  @default(company_admin)
  active                    Boolean                     @default(true)
  archived_at               DateTime?
  deletion_requested_at     DateTime?
  deletion_scheduled_for_at DateTime?
  deletion_requested_by     String?                     @db.VarChar(25)
  deletion_reason           String?                     @db.VarChar(255)
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  AdminCredential           AdminCredential?
  AdminSessionToken         AdminSessionToken[]
  AdminTenant               AdminTenant[]
  ArticlesCreated           Article[]                   @relation("ArticleCreatedBy")
  ArticlesLastEdited        Article[]                   @relation("ArticleLastEditedBy")
  NotificationsCreated      Notification[]              @relation("NotificationsCreated")
  NotificationReceipts      TenantNotificationReceipt[] @relation("NotificationReceipts")
  HotelClients              HotelClient[]
  AdminPermissionOverride   AdminPermissionOverride[]
}

model Tenant {
  id                        String                      @id @default(cuid()) @db.VarChar(25)
  name                      String                      @db.VarChar(100)
  slug                      String                      @unique @db.VarChar(50)
  /// @deprecated Fonte de verdade é TenantDomain (is_primary = true). Mantida
  /// por compatibilidade com o payload de tenant que o painel consome; será
  /// removida quando a última leitura sair do frontend.
  domain                    String?                     @db.VarChar(255)
  active                    Boolean                     @default(true)
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  archived_at               DateTime?
  deletion_requested_at     DateTime?
  deletion_scheduled_for_at DateTime?
  deletion_requested_by     String?                     @db.VarChar(25)
  deletion_reason           String?                     @db.VarChar(255)
  stripe_customer_id        String?                     @db.VarChar(255)
  subscription_status       String                      @default("none") @db.VarChar(50)
  timezone                  String                      @default("America/Sao_Paulo") @db.VarChar(100)
  tenant_type               ETenantType                 @default(COMMON)
  AdminTenant               AdminTenant[]
  Appointments              Appointment[]
  AppointmentBlockedPeriods AppointmentBlockedPeriod[]
  AppointmentScheduleConfig AppointmentScheduleConfig?
  Author                    Author[]
  Blog                      Blog[]
  leads                     Lead[]
  LeadCollection            LeadCollection[]
  UserCollection            UserCollection[]
  B2BFeeConfig              B2BFeeConfig?               @relation("B2BFeeConfig")
  B2BProducts               B2BProduct[]
  B2BPurchases              B2BPurchase[]
  B2CCheckoutSessions       B2CCheckoutSession[]        @relation("B2CCheckoutSessions")
  B2CFeeConfig              B2CFeeConfig?               @relation("B2CFeeConfig")
  B2CProductCategories      ProductCategory[]           @relation("B2CProductCategories")
  B2CProductPrices          ProductPrice[]              @relation("B2CProductPrices")
  B2CProducts               Product[]
  B2CUserProductAccess      UserProductAccess[]         @relation("B2CUserProductAccess")
  discountCoupons           DiscountCoupon[]            @relation("DiscountCoupons")
  StatsIntegration          StatsIntegration[]
  StripeSubscription        StripeSubscription?
  TenantBillingConfig       TenantBillingConfig?
  NotificationReceipts      TenantNotificationReceipt[]
  NotificationSettings      TenantNotificationSettings?
  HotelConfig               HotelClient?                @relation("HotelTenantConfig")
  HotelReservations         HotelReservation[]
  AdminPermissionOverride   AdminPermissionOverride[]
  TenantDomains             TenantDomain[]
  TenantSettings            TenantSetting[]
  ConversationAttributions  ConversationAttribution[]
  AttributionSettings       AttributionSettings?
  BotIntegrationConfig      BotIntegrationConfig?

  @@index([stripe_customer_id])
  @@index([subscription_status])
  @@index([tenant_type])
}

enum EAttributionSource {
  anuncio
  link
  organico
  site
}

model ConversationAttribution {
  id             String             @id @default(cuid()) @db.VarChar(25)
  tenant_id      String             @db.VarChar(25)
  numero_contato String             @db.VarChar(20)
  ocorrido_em    DateTime
  fonte          EAttributionSource
  ad_id          String?            @db.VarChar(100)
  adset_id       String?            @db.VarChar(100)
  campaign_id    String?            @db.VarChar(100)
  ctwa_clid      String?            @db.VarChar(255)
  link_code      String?            @db.VarChar(20)
  utm_source     String?            @db.VarChar(100)
  utm_medium     String?            @db.VarChar(100)
  utm_campaign   String?            @db.VarChar(100)
  primeiro_toque Boolean            @default(false)
  ultimo_toque   Boolean            @default(false)
  created_at     DateTime           @default(now())
  Tenant         Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, numero_contato])
  @@index([tenant_id, ocorrido_em])
  @@index([link_code])
  @@map("atribuicao_conversa")
}

model AttributionSettings {
  id              String   @id @default(cuid()) @db.VarChar(25)
  tenant_id       String   @unique @db.VarChar(25)
  window_days     Int      @default(30)
  source_priority Json     @default("[]")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  Tenant          Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("attribution_settings")
}

enum EBotContactStatus {
  ATIVO
  PAUSADO
}

enum EBotMessageRole {
  user
  assistant
  human
}

enum EBotMessageType {
  texto
  audio
  imagem
}

enum EFunnelStage {
  NOVO
  QUALIFICADO
  PAGAMENTO
  FECHADO
  FRIO
}

enum EFunnelEventAuthor {
  bot
  humano
}

model BotIntegrationConfig {
  id                             String    @id @default(cuid()) @db.VarChar(25)
  tenant_id                      String    @unique @db.VarChar(25)
  tenant_key_hash                String
  tenant_key_salt                String
  active                         Boolean   @default(true)
  n8n_stage_webhook_url          String?   @db.VarChar(500)
  n8n_config_publish_webhook_url String?   @db.VarChar(500)
  chatwoot_base_url              String?   @db.VarChar(500)
  last_heartbeat_at              DateTime?
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt
  Tenant                         Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("bot_integration_configs")
}

model BotIngestionEvent {
  id            String    @id @default(cuid()) @db.VarChar(25)
  tenant_id     String    @db.VarChar(25)
  event_id      String    @db.VarChar(100)
  event_type    String    @db.VarChar(50)
  occurred_at   DateTime
  payload       Json
  status        String    @default("RECEIVED") @db.VarChar(20) // RECEIVED | PROCESSED | FAILED
  error_message String?   @db.Text
  received_at   DateTime  @default(now())
  processed_at  DateTime?

  @@unique([tenant_id, event_id])
  @@index([tenant_id, event_type, received_at])
  @@map("bot_ingestion_events")
}

model BotContact {
  id                 String            @id @default(cuid()) @db.VarChar(25)
  tenant_id          String            @db.VarChar(25)
  numero_contato     String            @db.VarChar(20)
  nome               String?           @db.VarChar(150)
  origem             String?           @db.VarChar(20) // anuncio | organico
  status_bot         EBotContactStatus @default(ATIVO)
  motivo_pausa       String?           @db.VarChar(255)
  janela_expira      DateTime?
  consentimento_lgpd Boolean           @default(false)
  last_message_at    DateTime?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  @@unique([tenant_id, numero_contato])
  @@map("bot_contacts")
}

model BotMessage {
  id              String          @id @default(cuid()) @db.VarChar(25)
  tenant_id       String          @db.VarChar(25)
  numero_contato  String          @db.VarChar(20)
  role            EBotMessageRole
  tipo            EBotMessageType
  content_preview String?         @db.VarChar(280)
  ocorrido_em     DateTime
  created_at      DateTime        @default(now())

  @@index([tenant_id, numero_contato, ocorrido_em])
  @@map("bot_messages")
}

model FunnelEvent {
  id             String             @id @default(cuid()) @db.VarChar(25)
  tenant_id      String             @db.VarChar(25)
  numero_contato String             @db.VarChar(20)
  de_estagio     EFunnelStage?
  para_estagio   EFunnelStage
  autor_tipo     EFunnelEventAuthor
  autor_id       String?            @db.VarChar(25)
  motivo         String?            @db.VarChar(255)
  ocorrido_em    DateTime
  created_at     DateTime           @default(now())

  @@index([tenant_id, numero_contato, ocorrido_em])
  @@index([tenant_id, para_estagio])
  @@map("funil_eventos")
}

model BotLead {
  id                   String       @id @default(cuid()) @db.VarChar(25)
  tenant_id            String       @db.VarChar(25)
  numero_contato       String       @db.VarChar(20)
  current_stage        EFunnelStage @default(NOVO)
  perfil               String?      @db.VarChar(100)
  acomodacao_interesse String?      @db.VarChar(255)
  datas_interesse      Json?
  updated_at           DateTime     @updatedAt

  @@unique([tenant_id, numero_contato])
  @@map("bot_leads")
}

model FollowupAttempt {
  id             String   @id @default(cuid()) @db.VarChar(25)
  tenant_id      String   @db.VarChar(25)
  numero_contato String   @db.VarChar(20)
  tentativa      Int      @db.SmallInt // 1-4
  tipo_janela    String   @db.VarChar(10) // 4h | 24h | 72h | 7d
  status         String   @db.VarChar(20) // AGUARDANDO | RESPONDEU | FRIO
  ocorrido_em    DateTime
  created_at     DateTime @default(now())

  @@index([tenant_id, numero_contato])
  @@map("bot_followup_attempts")
}

model BotStageWebhookDispatch {
  id              String    @id @default(cuid()) @db.VarChar(25)
  tenant_id       String    @db.VarChar(25)
  funnel_event_id String    @db.VarChar(25)
  status          String    @default("PENDING") @db.VarChar(10) // PENDING | SENT | FAILED
  attempts        Int       @default(0) @db.SmallInt
  last_attempt_at DateTime?
  created_at      DateTime  @default(now())

  @@index([tenant_id, status])
  @@map("bot_stage_webhook_dispatches")
}

model BotDataRetentionSetting {
  id             String   @id @default(cuid()) @db.VarChar(25)
  tenant_id      String   @unique @db.VarChar(25)
  retention_days Int      @default(365)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("bot_data_retention_settings")
}

model TenantSetting {
  id         String   @id @default(cuid()) @db.VarChar(25)
  tenant_id  String   @db.VarChar(25)
  module     String   @db.VarChar(50)
  key        String   @db.VarChar(100)
  value      Json
  updated_by String?  @db.VarChar(25)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, module, key])
  @@index([tenant_id, module])
}

model TenantDomain {
  id         String   @id @default(cuid()) @db.VarChar(25)
  tenant_id  String   @db.VarChar(25)
  /// "domain" = host + subdomínios, https only. "regex" = padrão casado literalmente contra o Origin.
  type       String   @default("domain") @db.VarChar(10)
  value      String   @unique @db.VarChar(500)
  is_primary Boolean  @default(false)
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model TenantTypeModulePolicy {
  id          String      @id @default(cuid()) @db.VarChar(25)
  tenant_type ETenantType
  module_key  String      @db.VarChar(100)
  enabled     Boolean
  version     Int         @default(1)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@unique([tenant_type, module_key])
  @@index([tenant_type, enabled])
}

model LeadCollection {
  id              String                @id @default(cuid()) @db.VarChar(25)
  name            String                @db.VarChar(150)
  slug            String                @db.VarChar(100)
  source          String                @db.VarChar(100)
  source_type     String?               @db.VarChar(50)
  source_channel  String?               @db.VarChar(50)
  source_campaign String?               @db.VarChar(100)
  access_mode     ECollectionAccessMode @default(public)
  allowed_domains String[]              @default([])
  secret_key_hash String?
  secret_key_salt String?
  active          Boolean               @default(true)
  metadata        Json?
  tenant_id       String                @db.VarChar(25)
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  Lead            Lead[]
  Tenant          Tenant                @relation(fields: [tenant_id], references: [id])

  @@unique([slug, tenant_id])
  @@index([tenant_id])
}

model UserCollection {
  id          String                     @id @default(cuid()) @db.VarChar(25)
  name        String                     @db.VarChar(150)
  slug        String                     @db.VarChar(100)
  description String?                    @db.VarChar(255)
  active      Boolean                    @default(true)
  tenant_id   String                     @db.VarChar(25)
  created_at  DateTime                   @default(now())
  updated_at  DateTime                   @updatedAt
  Tenant      Tenant                     @relation(fields: [tenant_id], references: [id])
  Memberships UserCollectionMembership[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
}

model UserCollectionMembership {
  id            String              @id @default(cuid()) @db.VarChar(25)
  user_id       String              @db.VarChar(25)
  collection_id String              @db.VarChar(25)
  role          EUserCollectionRole @default(member)
  active        Boolean             @default(true)
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt
  Collection    UserCollection      @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  User          User                @relation(fields: [user_id], references: [id])

  @@unique([user_id, collection_id])
  @@index([user_id])
  @@index([collection_id])
}

model AdminTenant {
  id         String     @id @default(cuid()) @db.VarChar(25)
  admin_id   String     @db.VarChar(25)
  tenant_id  String     @db.VarChar(25)
  role       EAdminRole @default(manager)
  active     Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  Admin      Admin      @relation(fields: [admin_id], references: [id])
  Tenant     Tenant     @relation(fields: [tenant_id], references: [id])

  @@unique([admin_id, tenant_id])
}

enum EPermissionEffect {
  allow
  deny
}

// RBAC Fase 2 (2026-07-26): catálogo de permissões `recurso.ação`, fonte
// única de verdade em src/shared/auth/rbac/permission-matrix.ts.
model Permission {
  id                      String                    @id @default(cuid()) @db.VarChar(25)
  name                    String                    @unique @db.VarChar(100)
  created_at              DateTime                  @default(now())
  RolePermission          RolePermission[]
  AdminPermissionOverride AdminPermissionOverride[]

  @@map("permissions")
}

// Concessão papel → permissão. `role` é o EAdminRole global (não é
// per-tenant); PermissionsService faz cache desta tabela por 5 min.
model RolePermission {
  id            String     @id @default(cuid()) @db.VarChar(25)
  role          EAdminRole
  permission_id String     @db.VarChar(25)
  created_at    DateTime   @default(now())
  Permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role, permission_id])
  @@index([role])
  @@map("role_permissions")
}

// Exceção allow/deny por admin dentro de um tenant, por cima do que o papel
// concede. effect guarda a string literal 'grant' ou 'deny' (não o enum
// EPermissionEffect — ver Global Constraints). deny sempre vence no read.
model AdminPermissionOverride {
  id            String     @id @default(cuid()) @db.VarChar(25)
  admin_id      String     @db.VarChar(25)
  tenant_id     String     @db.VarChar(25)
  permission_id String     @db.VarChar(25)
  effect        String     @db.VarChar(5)
  created_by    String     @db.VarChar(25)
  created_at    DateTime   @default(now())
  Admin         Admin      @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  Tenant        Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([admin_id, tenant_id, permission_id])
  @@index([admin_id, tenant_id])
  @@map("admin_permission_overrides")
}

model Blog {
  id                  String           @id @default(cuid()) @db.VarChar(25)
  name                String           @db.VarChar(150)
  description         String?
  secret_key_hash     String
  secret_key_salt     String
  tenant_id           String           @db.VarChar(25)
  active              Boolean          @default(true)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  media_collection_id String?          @db.VarChar(25)
  Article             Article[]
  MediaCollection     MediaCollection? @relation(fields: [media_collection_id], references: [id])
  Tenant              Tenant           @relation(fields: [tenant_id], references: [id])

  @@unique([name, tenant_id])
  @@index([tenant_id])
  @@index([media_collection_id])
}

model Article {
  id                String         @id @default(cuid()) @db.VarChar(25)
  display_title     String         @db.VarChar(255)
  meta_title        String         @db.VarChar(60)
  meta_description  String?        @db.VarChar(160)
  focus_keyword     String?        @db.VarChar(100)
  content           String
  slug              String         @db.VarChar(255)
  status            EArticleStatus @default(draft)
  published_at      DateTime?
  scheduled_at      DateTime?
  cover_image_id    String?        @db.VarChar(25)
  author_id         String?        @db.VarChar(25)
  blog_id           String         @db.VarChar(25)
  created_by        String?        @db.VarChar(25)
  last_edited_by    String?        @db.VarChar(25)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  language          String         @default("en_us") @db.VarChar(10)
  Author            Author?        @relation(fields: [author_id], references: [id])
