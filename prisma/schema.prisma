  created_by   String              @db.VarChar(25)
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt
  HotelClient  HotelClient         @relation(fields: [client_id], references: [id])
  Clicks       WhatsAppLinkClick[]

  @@index([client_id])
  @@index([short_code])
  @@map("whatsapp_tracking_links")
}

model WhatsAppLinkClick {
  id          String               @id @default(cuid()) @db.VarChar(25)
  link_id     String               @db.VarChar(25)
  clicked_at  DateTime             @default(now())
  ip_address  String?              @db.VarChar(45)
  user_agent  String?              @db.Text
  referer     String?              @db.VarChar(500)
  country     String?              @db.VarChar(100)
  region      String?              @db.VarChar(100)
  city        String?              @db.VarChar(100)
  device_type String?              @db.VarChar(20)
  Link        WhatsAppTrackingLink @relation(fields: [link_id], references: [id], onDelete: Cascade)

  @@index([link_id, clicked_at])
  @@map("whatsapp_link_clicks")
}

model RateParityCheck {
  id            String      @id @default(cuid()) @db.VarChar(25)
  client_id     String      @db.VarChar(25)
  check_date    DateTime
  direct_rate   Float
  booking_rate  Float?
  expedia_rate  Float?
  airbnb_rate   Float?
  has_violation Boolean     @default(false)
  notes         String?     @db.Text
  inserted_by   String      @db.VarChar(25)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  HotelClient   HotelClient @relation(fields: [client_id], references: [id])

  @@index([client_id, check_date])
  @@index([client_id, has_violation])
  @@map("rate_parity_checks")
}

model MarketingBudget {
  id                String      @id @default(cuid()) @db.VarChar(25)
  client_id         String      @db.VarChar(25)
  reference_month   DateTime
  total_budget      Float
  meta_ads_budget   Float       @default(0)
  google_ads_budget Float       @default(0)
  other_budget      Float       @default(0)
  notes             String?     @db.Text
  inserted_by       String      @db.VarChar(25)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  HotelClient       HotelClient @relation(fields: [client_id], references: [id])

  @@unique([client_id, reference_month])
  @@index([client_id, reference_month])
  @@map("marketing_budgets")
}

model HotelGuest {
  id             String        @id @default(cuid()) @db.VarChar(25)
  client_id      String        @db.VarChar(25)
  name           String        @db.VarChar(255)
  email          String?       @db.VarChar(255)
  phone          String?       @db.VarChar(20)
  country        String?       @db.VarChar(100)
  segment        EGuestSegment @default(leisure)
  total_stays    Int           @default(0)
  total_revenue  Float         @default(0)
  first_stay     DateTime?
  last_stay      DateTime?
  booking_source String?       @db.VarChar(100)
  notes          String?       @db.Text
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  HotelClient    HotelClient   @relation(fields: [client_id], references: [id])
  Stays          GuestStay[]

  @@index([client_id])
  @@index([client_id, segment])
  @@index([client_id, last_stay])
  @@map("hotel_guests")
}

model GuestStay {
  id                  String     @id @default(cuid()) @db.VarChar(25)
  guest_id            String     @db.VarChar(25)
  check_in            DateTime
  check_out           DateTime
  room_type           String?    @db.VarChar(100)
  revenue             Float      @default(0)
  booking_source      String?    @db.VarChar(100)
  booking_window_days Int?
  notes               String?    @db.Text
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt
  Guest               HotelGuest @relation(fields: [guest_id], references: [id])

  @@index([guest_id])
  @@index([guest_id, check_in])
  @@map("guest_stays")
}

enum EBookingEngineType {
  MANUAL
  OMNIBEES
  STAYS
  FOCO
  HITS
  TOTVS
  GENERIC_WEBHOOK
}

enum EReservationSource {
  DIRECT
  BOOKING_COM
  EXPEDIA
  AIRBNB
  TRIPADVISOR
  GOOGLE_HOTEL_ADS
  OTHER_OTA
  MANUAL
}

enum EReservationStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  CHECKED_IN
  CHECKED_OUT
}

model HotelReservation {
  id                  String             @id @default(cuid()) @db.VarChar(25)
  tenant_id           String             @db.VarChar(25)
  external_id         String?            @db.VarChar(100)
  engine_type         EBookingEngineType @default(MANUAL)
  source              EReservationSource @default(DIRECT)
  status              EReservationStatus @default(CONFIRMED)
  guest_name          String             @db.VarChar(255)
  guest_email         String?            @db.VarChar(255)
  guest_phone         String?            @db.VarChar(20)
  guest_country       String?            @db.VarChar(100)
  check_in            DateTime           @db.Date
  check_out           DateTime           @db.Date
  room_type           String?            @db.VarChar(100)
  total_amount        Float              @default(0)
  commission_amount   Float              @default(0)
  booking_date        DateTime
  booking_window_days Int?
  raw_payload         Json?
  processed           Boolean            @default(false)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  Tenant              Tenant             @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, status])
  @@index([tenant_id, source])
  @@index([tenant_id, check_in])
  @@index([tenant_id, booking_date])
  @@index([external_id])
  @@map("hotel_reservations")
}

// ============================================================
// PAINEL RESERVE — Fase 4: Instagram + Conteúdo
// ============================================================

/**
 * Daily follower/engagement snapshot for a tenant's connected Instagram
 * account. followers_count has no historical API — this table is the
 * historical record, upserted once per (tenant, day) by the sync cron
 * (§3.6: "registrar snapshot no dia do onboarding como baseline").
 */
model IgDailySnapshot {
  id                 String   @id @default(cuid()) @db.VarChar(25)
  tenant_id          String   @db.VarChar(25)
  date               DateTime @db.Date
  followers_count    Int      @default(0)
  reach              Int      @default(0)
  engaged_accounts   Int      @default(0)
  total_interactions Int      @default(0)
  created_at         DateTime @default(now())

  @@unique([tenant_id, date])
  @@map("ig_daily_snapshot")
}

enum EContentPlatform {
  instagram
  facebook
}

enum EContentPostStatus {
  draft
  scheduled
  published
}

/**
 * Content calendar entry. Admin-authored (draft/scheduled) and/or synced
 * from Meta once published — see Fase 4 Task 6's spike doc for whether the
 * Graph API exposes Business-Suite-scheduled posts; this schema assumes the
 * "ContentPost as source of truth, Meta only confirms published_at/permalink"
 * fallback path by default.
 */
model ContentPost {
  id              String              @id @default(cuid()) @db.VarChar(25)
  tenant_id       String              @db.VarChar(25)
  platform        EContentPlatform
  scheduled_for   DateTime?
  published_at    DateTime?
  status          EContentPostStatus  @default(draft)
  caption_preview String?             @db.VarChar(280)
  thumbnail_url   String?             @db.VarChar(500)
  external_id     String?             @db.VarChar(100)
  permalink       String?             @db.VarChar(500)
  created_by      String              @db.VarChar(25)
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  @@index([tenant_id, scheduled_for])
  @@index([tenant_id, published_at])
  @@index([tenant_id, status])
  @@map("content_posts")
}

enum EActivityLogType {
  auto
  manual
}

enum EActivityLogCategory {
  post
  campaign
  report
  bot
  meeting
  other
}

/**
 * Append-style feed of client-facing activity events. A plain injectable
 * service method (ActivityLogService.record), not an event bus — matching
 * the codebase's existing direct-service-call convention
 * (NotificationEventService.dispatch is called directly from call sites
 * today, not via emitted events).
 */
model ActivityLog {
  id          String               @id @default(cuid()) @db.VarChar(25)
  tenant_id   String               @db.VarChar(25)
  type        EActivityLogType
  category    EActivityLogCategory
  title       String               @db.VarChar(255)
  description String?              @db.Text
  icon        String?              @db.VarChar(50)
  created_by  String?              @db.VarChar(25)
  created_at  DateTime             @default(now())

  @@index([tenant_id, created_at])
  @@map("activity_log")
}
