generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int                         @id @default(autoincrement())
  email                     String                      @unique
  name                      String                      @db.VarChar(100)
  cpf                       String                      @db.VarChar(11)
  phone_number              String                      @db.VarChar(13)
  sex                       Int?                        @default(1) @db.SmallInt
  date_of_birth             DateTime?                   @db.Date
  date_expires_in           DateTime?                   @db.Date
  plan_id                   Int
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  Brand                     Brand[]
  BrandAlert                BrandAlert[]
  BrandAnalysis             BrandAnalysis[]
  BrandAnalysisRequest      BrandAnalysisRequest[]
  BrandAnalysisToken        BrandAnalysisToken[]
  BrandMonitoring           BrandMonitoring[]
  BrandNotification         BrandNotification[]
  CompanyExport             CompanyExport[]
  MonitoringPlan            MonitoringPlan[]
  Order                     Order[]
  PibotMessages             PibotMessages[]
  Search                    Search[]
  Subscription              Subscription[]
  Plan                      Plan                        @relation(fields: [plan_id], references: [id])
  Credential                UserCredential?
  UserPasswordChangeSession UserPasswordChangeSession[]
  UserSessionToken          UserSessionToken[]
}

model Plan {
  id                        Int              @id @default(autoincrement())
  name                      String           @db.VarChar(100)
  slug                      String           @unique
  maximum_queries           Int
  maximum_queries_to_export Int              @default(0)
  maximum_brand_analysis    Int              @default(0)
  month_price_id            String?
  annual_price_id           String?
  created_at                DateTime         @default(now())
  updated_at                DateTime         @default(now()) @updatedAt
  MonitoringPlan            MonitoringPlan[]
  Subscription              Subscription[]
  User                      User[]
}

// SELECT
//     c.id AS company_id,
// 	a.id AS auxiliary_company_information_id,
// 	c.cnpj,
// 	c.branch_type,
// 	c.business_name,
// 	c.status,
// 	c.date_status,
// 	c.code_detail_status,
// 	c.outer_city,
// 	c.coutry_code,
// 	c.start_date,
// 	c.main_cnae_id,
// 	c.type_of_place,
// 	c.place,
// 	c.house_number,
// 	c.address_complement,
// 	c.district,
// 	c.cep,
// 	c.uf,
// 	c.city_code,
// 	c.ddd_1,
// 	c.phone_1,
// 	c.ddd_2,
// 	c.phone_2,
// 	c.ddd_fax,
// 	c.fax,
// 	c.email,
// 	c.special_citation,
// 	c.special_citation_date,
// 	c.load_update_date,
// 	a.fantasy_name,
// 	a.legal_nature,
// 	a.qualification_representative_before_cnpj,
// 	a.social_capital,
// 	a.size,
// 	a.federative_entity,
// 	c.created_at AS company_created_at, 
// 	c.updated_at AS company_updated_at
// FROM
//     "public"."Company" c
// JOIN
//     "public"."AuxiliaryCompanyInformation" a
// ON
//     LEFT(c.cnpj, 8) = a.cnpj

view ViewCompany {
  company_id                               Int
  auxiliary_company_information_id         Int
  cnpj                                     String?
  branch_type                              Int?
  business_name                            String?
  status                                   String?
  date_status                              DateTime?
  code_detail_status                       String?
  outer_city                               String?
  coutry_code                              String?
  main_cnae                                String?
  secondary_cnae                           String?
  start_date                               DateTime?
  type_of_place                            String?
  place                                    String?
  house_number                             String?
  address_complement                       String?
  district                                 String?
  cep                                      String?
  uf                                       String?
  city_code                                String?
  ddd_1                                    String?
  phone_1                                  String?
  ddd_2                                    String?
  phone_2                                  String?
  ddd_fax                                  String?
  fax                                      String?
  email                                    String?
  special_citation                         String?
  special_citation_date                    DateTime?
  load_update_date                         DateTime?
  fantasy_name                             String?
  legal_nature                             String?
  qualification_representative_before_cnpj String?
  social_capital                           Decimal?
  size                                     String?
  federative_entity                        String?
  company_created_at                       DateTime
  company_updated_at                       DateTime
  // @@index([business_name, cnpj], type: )

  @@unique([company_id])
  @@map("viewcompany")
}

model PibotMessages {
  id                Int      @id @default(autoincrement())
  chat_id           String   @db.VarChar(100)
  choices           Json
  completion_tokens Int
  prompt_tokens     Int
  total_tokens      Int
  usage             Json
  user_id           Int
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  User              User     @relation(fields: [user_id], references: [id])
}

model Subscription {
  id                     Int       @id @default(autoincrement())
  name                   String
  subscription_id        String    @unique
  customer_id            String
  status                 String
  string_plan_id         String
  string_plan_nickname   String?
  string_plan_amount     Int
  string_plan_currency   String
  interval               String
  start_date             DateTime
  current_period_start   DateTime
  current_period_end     DateTime
  trial_end              DateTime?
  cancel_at              DateTime?
  canceled_at            DateTime?
  ended_at               DateTime?
  billing_cycle_anchor   DateTime
  payment_method         String?
  default_payment_method String?
  auto_renew             Boolean
  quantity               Int
  tax_percent            Float?
  discount               Json?
  latest_invoice_id      String?
  next_invoice_date      DateTime?
  cancel_at_period_end   Boolean
  metadata               Json?
  created_from_webhook   Boolean
  event_history          Json?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  plan_id                Int
  user_id                Int
  Plan                   Plan      @relation(fields: [plan_id], references: [id])
  User                   User      @relation(fields: [user_id], references: [id])

  @@index([subscription_id])
  @@index([customer_id])
}

model AdditionalTokenPack {
  id          Int      @id @default(autoincrement())
  slug        String
  external_id String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Order {
  id                   Int      @id @default(autoincrement())
  amount               Int
  currency             String
  product_name         String
  status               String
  quantity             Int
  created_from_webhook Boolean
  metadata             Json?
  customer_id          String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  user_id              Int
  User                 User     @relation(fields: [user_id], references: [id])

  @@index([customer_id])
}

model MonitoringPlan {
  id                   Int       @id @default(autoincrement())
  plan_amount          Decimal   @db.Money
  status               Int       @db.SmallInt
  checkout_status      String
  plan_nickname        String?
  plan_currency        String
  interval             String
  start_date           DateTime
  current_period_start DateTime
  current_period_end   DateTime
  trial_end            DateTime?
  cancel_at            DateTime?
  canceled_at          DateTime?
  ended_at             DateTime?
  billing_cycle_anchor DateTime
  plan_id              Int?
  brand_id             Int?
  subscription_id      String    @unique
  user_id              Int
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  Brand                Brand?    @relation(fields: [brand_id], references: [id])
  Plan                 Plan?     @relation(fields: [plan_id], references: [id])
  User                 User      @relation(fields: [user_id], references: [id])
}

model UserSessionToken {
  id         Int      @id @default(autoincrement())
  hash_token String
  salt       String
  user_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  User       User     @relation(fields: [user_id], references: [id])
}

model UserCredential {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  hash       String
  salt       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  User       User     @relation(fields: [user_id], references: [id])
}

model UserCredentialHistory {
  id         Int      @id @default(autoincrement())
  user_id    Int
  hash       String
  salt       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model UserPasswordChangeSession {
  id         Int       @id @default(autoincrement())
  slug       String    @db.VarChar(64)
  status     Int       @db.SmallInt
  hash_token String
  salt       String
  lat        String?
  long       String?
  device_ip  String    @db.VarChar(16)
  expires_in DateTime
  expired_at DateTime?
  user_id    Int
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  User       User      @relation(fields: [user_id], references: [id])
}

model Company {
  id                    Int       @id @default(autoincrement())
  cnpj                  String    @unique @db.VarChar(14)
  branch_type           Int       @db.SmallInt
  business_name         String?   @db.VarChar(255)
  status                String    @db.VarChar(2)
  date_status           DateTime? @db.Date
  code_detail_status    String    @db.VarChar(2)
  outer_city            String?   @db.VarChar(70)
  coutry_code           String?   @db.VarChar(20)
  start_date            DateTime? @db.Date
  main_cnae             String?   @db.VarChar(16)
  secondary_cnae        String?
  type_of_place         String?   @db.VarChar(20)
  place                 String?   @db.VarChar(120)
  house_number          String?   @db.VarChar(25)
  address_complement    String?   @db.VarChar(156)
  district              String?   @db.VarChar(120)
  cep                   String?   @db.VarChar(10)
  uf                    String?   @db.VarChar(5)
  city_code             String?   @db.VarChar(5)
  ddd_1                 String?   @db.VarChar(5)
  phone_1               String?   @db.VarChar(8)
  ddd_2                 String?   @db.VarChar(5)
  phone_2               String?   @db.VarChar(8)
  ddd_fax               String?   @db.VarChar(5)
  fax                   String?   @db.VarChar(8)
  email                 String?   @db.VarChar(115)
  special_citation      String?   @db.VarChar(150)
  special_citation_date DateTime? @db.Date
  load_update_date      DateTime  @db.Date
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt

  @@index([uf, city_code, branch_type, business_name, status, date_status, code_detail_status, coutry_code, start_date, main_cnae, secondary_cnae, created_at(sort: Desc)])
}

model AuxiliaryCompanyInformation {
  id                                       Int      @id @default(autoincrement())
  cnpj                                     String   @unique @db.VarChar(14)
  fantasy_name                             String?  @db.VarChar(150)
  legal_nature                             String?  @db.VarChar(4)
  qualification_representative_before_cnpj String?  @db.VarChar(2)
  social_capital                           Decimal? @db.Decimal(22, 2)
  size                                     String?  @db.VarChar(2)
  federative_entity                        String?  @db.VarChar(100)
  created_at                               DateTime @default(now())
  updated_at                               DateTime @default(now()) @updatedAt
}

model Search {
  id         Int      @id @default(autoincrement())
  amount     Int
  limit      Int      @db.SmallInt
  hash       String   @unique @db.VarChar(100)
  filters    Json
  user_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  User       User     @relation(fields: [user_id], references: [id])
}

model TaxRegime {
  id               Int      @id @default(autoincrement())
  cnpj             String   @db.VarChar(14)
  year             DateTime @db.Date
  scp_cnpj         String   @db.VarChar(115)
  type_of_taxation Int      @db.SmallInt
  taxation         String   @db.VarChar(115)
  company_id       Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Partner {
  id                           Int       @id @default(autoincrement())
  cnpj                         String    @db.VarChar(14)
  partner_type                 String    @db.VarChar(2)
  name                         String?   @db.VarChar(150)
  etary_age                    String?   @db.VarChar(10)
  identifier                   String    @db.VarChar(14)
  inclusion_date               DateTime? @db.Date
  coutry_code                  String?   @db.VarChar(5)
  cpf_representative           String?   @db.VarChar(11)
  name_representative          String?   @db.VarChar(150)
  representative_qualification String?   @db.VarChar(2)
  company_id                   Int?
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt
}

model Brand {
  id                Int                 @id @default(autoincrement())
  name              String
  identifier        String?             @db.VarChar(14)
  email             String
  phone_number      String
  user_id           Int
  inpi_number       String?             @db.VarChar(30)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  User              User                @relation(fields: [user_id], references: [id])
  BrandAlert        BrandAlert[]
  BrandMonitoring   BrandMonitoring[]
  BrandNotification BrandNotification[]
  MonitoringPlan    MonitoringPlan[]
}

model Cnae {
  id         Int      @id @default(autoincrement())
  code       String   @db.VarChar(11)
  name       String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Journal {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  extension  String   @db.VarChar(10)
  size       String
  loaded     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model JournalToFetch {
  id           Int            @id @default(autoincrement())
  zip_name     String         @unique @db.VarChar(100)
  name         String         @db.VarChar(100)
  searched     Boolean        @default(false)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  BrandAlert   BrandAlert[]
  JournalAlert JournalAlert[]
}

model BrandAlert {
  id                   Int             @id @default(autoincrement())
  brand                String?
  deposit_date         DateTime?
  conception_date      DateTime?
  effective_date       DateTime?
  nature               String?         @db.VarChar(100)
  presentation         String?         @db.VarChar(100)
  classe_nice          Json?
  prioridade_unionista Json?
  apostila             String?
  classe_viena         Json?
  journal_number       String
  journal_date         DateTime
  process_number       String          @db.VarChar(50)
  attorney             String?
  titular              Json
  despacho             Json
  sobrestador          Json
  brand_id             Int
  brand_monitoring_id  Int
  user_id              Int
  jornal_to_fetch_id   Int
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  Brand                Brand           @relation(fields: [brand_id], references: [id])
  BrandMonitoring      BrandMonitoring @relation(fields: [brand_monitoring_id], references: [id])
  Journal_to_fetch     JournalToFetch  @relation(fields: [jornal_to_fetch_id], references: [id])
  User                 User            @relation(fields: [user_id], references: [id])
}

model BrandMonitoring {
  id                      Int                 @id @default(autoincrement())
  processed_last_analysis Int                 @default(0)
  total_processed         Int                 @default(0)
  triggered_notifications Int                 @default(0)
  status                  Int                 @db.SmallInt
  user_id                 Int
  brand_id                Int
  inpi_number             String?             @db.VarChar(30)
  last_magazine_searched  String?             @db.VarChar(20)
  last_movement           DateTime?
  deposit                 DateTime?
  last_search             DateTime?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  BrandAlert              BrandAlert[]
  Brand                   Brand               @relation(fields: [brand_id], references: [id])
  User                    User                @relation(fields: [user_id], references: [id])
  BrandNotification       BrandNotification[]
}

model JournalAlert {
  id                   Int            @id @default(autoincrement())
  brand                String?
  deposit_date         DateTime?
  conception_date      DateTime?
  effective_date       DateTime?
  nature               String?        @db.VarChar(100)
  presentation         String?        @db.VarChar(100)
  classe_nice          Json?
  prioridade_unionista Json?
  apostila             String?
  classe_viena         Json?
  journal_number       String
  journal_date         DateTime
  process_number       String         @db.VarChar(50)
  attorney             String?
  titular              Json
  despacho             Json
  sobrestador          Json
  jornal_to_fetch_id   Int
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  Journal_to_fetch     JournalToFetch @relation(fields: [jornal_to_fetch_id], references: [id])

  @@index([brand], type: SpGist)
}

model BrandAnalysis {
  id                   Int                    @id @default(autoincrement())
  user_message         Json
  response             Json
  json_data_response   Json
  md_data_reposnse     Json
  html_data_response   Json
  brand                String                 @db.VarChar(255)
  niche                String                 @db.VarChar(155)
  description          String                 @db.VarChar(255)
  user_id              Int
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  User                 User                   @relation(fields: [user_id], references: [id])
  BrandAnalysisRequest BrandAnalysisRequest[]
  BrandAnalysisToken   BrandAnalysisToken[]

  @@index([brand])
}

model BrandAnalysisRequest {
  id                      Int                @id @default(autoincrement())
  valid                   Boolean
  brand_analysis_id       Int?
  user_id                 Int
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt
  brand_analysis_token_id Int
  Brand_analysis          BrandAnalysis?     @relation(fields: [brand_analysis_id], references: [id])
  Brand_analysis_token    BrandAnalysisToken @relation(fields: [brand_analysis_token_id], references: [id])
  User                    User               @relation(fields: [user_id], references: [id])
}

model BrandAnalysisToken {
  id                   Int                    @id @default(autoincrement())
  status               Int                    @db.SmallInt
  brand_analysis_id    Int?
  user_id              Int
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  BrandAnalysisRequest BrandAnalysisRequest[]
  Brand_analysis       BrandAnalysis?         @relation(fields: [brand_analysis_id], references: [id])
  User                 User                   @relation(fields: [user_id], references: [id])
}

model BrandNotification {
  id                  Int             @id @default(autoincrement())
  brand_id            Int
  user_id             Int
  brand_monitoring_id Int
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  Brand               Brand           @relation(fields: [brand_id], references: [id])
  Brand_monitoring    BrandMonitoring @relation(fields: [brand_monitoring_id], references: [id])
  User                User            @relation(fields: [user_id], references: [id])
}

model CompanyExport {
  id             Int       @id @default(autoincrement())
  total_exported Int
  company_count  Int
  status         Int       @db.SmallInt
  page           Int
  page_count     Int
  public_link    String?
  deletion_date  DateTime?
  filters        Json
  user_id        Int
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  User           User      @relation(fields: [user_id], references: [id])
}

model PublicBrandSearch {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  brand      String
  radical    Boolean
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model APIToken {
  id                 Int      @id @default(autoincrement())
  api_identifier     String   @unique @db.VarChar(25)
  hash_id_token      String
  hash_acess_token   String
  hash_refresh_token String
  salt               String
  last_refresh       Int?
  expires_in         DateTime
  active             Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String?  @db.VarChar(255)
  email        String?
  phone_number String?  @db.VarChar(14)
  origin       Int?     @db.SmallInt
  origin_font  String?  @db.VarChar(50)
  description  String?
  data         Json?
  status       Int?     @default(1) @db.SmallInt
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model LeadQualificationMessage {
  id                 Int      @id @default(autoincrement())
  analyzed           Boolean  @default(false)
  temperature        Int?     @db.SmallInt
  prompt_token       Int
  completion_token   Int
  json               Json
  profile_name       String   @db.VarChar(100)
  phone_number_id    String   @db.VarChar(100)
  phone_number       String   @db.VarChar(80)
  type               String   @db.VarChar(30)
  kb_card            String   @default("sem-contato")
  screening_complete Boolean  @default(false)
  message            String
  message_date       DateTime
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
