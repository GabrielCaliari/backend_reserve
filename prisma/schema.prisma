}


// ============================================
// Tenant Billing Config — Per-tenant payment settings
// ============================================

enum EBillingInterval {
  monthly
  quarterly
  semiannual
  annual
}

enum EBillingCollectionMode {
  upfront    // Full period charged at once (e.g. R$479 for annual)
  installments // Monthly installments with discount (e.g. R$39.92/mo x12)
}

model TenantBillingConfig {
  id                     String                 @id @default(cuid()) @db.VarChar(25)
  tenant_id              String                 @unique @db.VarChar(25)

  // Stripe keys (per-tenant, overrides global env vars)
  stripe_publishable_key String?                @db.VarChar(255)
  stripe_secret_key_hash String?                @db.VarChar(255) // stored encrypted
  stripe_webhook_secret_hash String?            @db.VarChar(255) // stored encrypted

  // Stripe Price IDs configured for this tenant
  stripe_price_ids       Json?                  // { monthly: "price_xxx", annual: "price_yyy", ... }

  // Billing behavior
  billing_interval       EBillingInterval       @default(monthly)
  billing_collection_mode EBillingCollectionMode @default(upfront)

  // Trial settings
  trial_enabled          Boolean                @default(false)
  trial_days             Int                    @default(7) @db.SmallInt

  // Display / UI hints (sent to panel for rendering)
  currency               String                 @default("brl") @db.VarChar(3)
  plan_name              String?                @db.VarChar(100)
  plan_description       String?                @db.VarChar(255)

  // Redirect URLs after Stripe Checkout (per-tenant, overrides FRONTEND_URL env var)
  checkout_success_url   String?                @db.VarChar(500)
  checkout_cancel_url    String?                @db.VarChar(500)

  // Metadata (any extra config the panel needs)
  metadata               Json?

  active                 Boolean                @default(true)
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt

  Tenant                 Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("tenant_billing_configs")
}

// ============================================
// Stripe Subscriptions — Payment Integration
// ============================================

model StripeSubscription {
  id                     String    @id @default(cuid()) @db.VarChar(25)
  tenant_id              String    @unique @db.VarChar(25)
  
  // Stripe IDs
  stripe_subscription_id String    @unique @db.VarChar(255)
  stripe_customer_id     String    @db.VarChar(255)
  stripe_price_id        String    @db.VarChar(255)
  stripe_product_id      String?   @db.VarChar(255)
  
  // Status
  status                 String    @db.VarChar(50) // active, canceled, past_due, trialing, incomplete, etc.
  
  // Dates
  current_period_start   DateTime
  current_period_end     DateTime
  trial_start            DateTime?
  trial_end              DateTime?
  canceled_at            DateTime?
  cancel_at_period_end   Boolean   @default(false)
  
  // Financial
  amount                 Int       // Amount in cents
  currency               String    @default("brl") @db.VarChar(3)
  interval               String    @db.VarChar(20) // month, year, week, day
  interval_count         Int       @default(1) @db.SmallInt
  
  // Metadata
  metadata               Json?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  
  Tenant                 Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  
  @@index([stripe_subscription_id])
  @@index([stripe_customer_id])
  @@index([tenant_id, status])
  @@index([status])
  @@map("stripe_subscriptions")
}

model StripeWebhookEvent {
  id              String    @id @default(cuid()) @db.VarChar(25)
  stripe_event_id String    @unique @db.VarChar(255)
  event_type      String    @db.VarChar(100)
  payload         Json
  processed       Boolean   @default(false)
  error_message   String?   @db.Text
  processing_attempts Int   @default(0) @db.SmallInt
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  
  @@index([event_type, processed])
  @@index([created_at])
  @@index([processed, processing_attempts])
  @@map("stripe_webhook_events")
}

// ============================================
// Stripe Plans — Product+Price pairs managed via API
// ============================================

model StripePlan {
  id                              String   @id @default(cuid()) @db.VarChar(25)
  slug                            String   @unique @db.VarChar(100)
  plan_name                       String   @db.VarChar(100)
  description                     String?  @db.Text

  // Stripe IDs
  stripe_product_id               String   @unique @db.VarChar(255)
  stripe_price_id                 String   @unique @db.VarChar(255)  // recurring price
  stripe_trial_price_id           String?  @unique @db.VarChar(255)  // optional free-trial price

  // Billing configuration
  billing_interval                Int      @db.SmallInt              // 1=weekly 2=monthly 3=quarterly 4=annual
  unit_amount                     Int                                // in cents
  currency                        String   @default("brl") @db.VarChar(3)

  // Credits / limits
  released_credits                Int      @default(0)
  credits_released_trial_period   Int      @default(0)
  guest_limit                     Int      @default(0)
  trial_days                      Int      @default(7) @db.SmallInt

  // Control
  active                          Boolean  @default(true)
  created_at                      DateTime @default(now())
  updated_at                      DateTime @updatedAt

  @@index([active])
  @@index([slug])
  @@map("stripe_plans")
}

// ============================================
// B2C Student Subscriptions
// ============================================

model Product {
  id                String         @id @default(cuid()) @db.VarChar(25)
  tenant_id         String         @db.VarChar(25)
  stripe_product_id String         @db.VarChar(100)
  name              String         @db.VarChar(255)
  description       String?        @db.Text
  slug              String         @db.VarChar(100)
  categories        String[]       @default([])
  active            Boolean        @default(true)

  // Fee overrides — null = herda da categoria ou da taxa global do tenant
  category_id              String?  @db.VarChar(25)  // null = sem categoria
  chip_cost_override       Float?                    // % override (ex: 2.5 = 2.5%). null = herda
  shipping_fee_override    Int?                      // centavos override. null = herda
  requires_shipping        Boolean  @default(false)  // true para produtos físicos (books, tabs)

  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category          ProductCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  ProductPrice      ProductPrice[]
  UserProductAccess UserProductAccess[]

  @@unique([tenant_id, stripe_product_id])
  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@index([tenant_id, active])
  @@index([tenant_id, category_id])
  @@map("b2c_products")
}

// Categorias de produto com taxas padrão por categoria
// Ex: "Books" com chip_cost 2% e shipping R$15,00
model ProductCategory {
  id                String   @id @default(cuid()) @db.VarChar(25)
  tenant_id         String   @db.VarChar(25)
  name              String   @db.VarChar(100)  // Ex: "Books", "Tabs", "Courses"
  slug              String   @db.VarChar(100)  // Ex: "books", "tabs", "courses"

  // Taxas padrão desta categoria (null = herda da taxa global do tenant)
  chip_cost_percent Float?                     // % sobre o preço (ex: 2.5 = 2.5%)
  shipping_fee      Int?                       // Frete fixo em centavos. null = herda do tenant

  active            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  tenant            Tenant    @relation("B2CProductCategories", fields: [tenant_id], references: [id], onDelete: Cascade)
  products          Product[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@index([tenant_id, active])
  @@map("b2c_product_categories")
}

// Taxa global do tenant — base quando não há categoria ou override
model B2CFeeConfig {
  id                String   @id @default(cuid()) @db.VarChar(25)
  tenant_id         String   @unique @db.VarChar(25)

  chip_cost_percent Float    @default(0)  // % global (ex: 2.5 = 2.5%)
  shipping_fee      Int      @default(0)  // Frete fixo global em centavos

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  tenant            Tenant   @relation("B2CFeeConfig", fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("b2c_fee_config")
}

enum EBillingMode {
  unlimited           // Recorrente ilimitado
  limited             // Recorrente limitado (N cobranças)
  one_time            // Pagamento único vitalício
  one_time_exp        // Pagamento único com expiração
}

enum EAccessType {
  subscription        // Acesso via subscription (unlimited/limited)
  lifetime            // Acesso vitalício (one_time)
  temporary           // Acesso temporário (one_time_exp)
}

model ProductPrice {
  id              String         @id @default(cuid()) @db.VarChar(25)
  tenant_id       String         @db.VarChar(25)
  stripe_price_id String         @db.VarChar(100)
  product_id      String         @db.VarChar(25)
  Product         Product        @relation(fields: [product_id], references: [id])
  tenant          Tenant         @relation("B2CProductPrices", fields: [tenant_id], references: [id], onDelete: Cascade)
  
  name            String         @db.VarChar(100)  // "Mensal", "Anual", "Vitalício"
  
  // Billing configuration
  billing_mode    String         @default("unlimited") @db.VarChar(20)  // unlimited | limited | one_time | one_time_exp
  interval        String?        @db.VarChar(20)   // month | year | week (null for one_time)
  interval_count  Int?           @default(1) @db.SmallInt
  unit_amount     Int                               // cents
  currency        String         @default("brl") @db.VarChar(3)
  
  // Limits (mode-specific)
  max_billing_cycles   Int?      // For limited: max charges before auto-cancel
  access_duration_days Int?      // For one_time_exp: days of access
  
  active          Boolean        @default(true)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  UserProductAccess UserProductAccess[]

  @@unique([tenant_id, stripe_price_id])
  @@index([tenant_id])
  @@index([product_id, active])
  @@index([tenant_id, billing_mode])
  @@map("b2c_product_prices")
}

model UserProductAccess {
  id                       String    @id @default(cuid()) @db.VarChar(25)
  tenant_id                String    @db.VarChar(25)
  user_id                  String    @db.VarChar(25)
  User                     User      @relation(fields: [user_id], references: [id])
  product_id               String    @db.VarChar(25)
  Product                  Product   @relation(fields: [product_id], references: [id])
  product_price_id         String    @db.VarChar(25)
  ProductPrice             ProductPrice @relation(fields: [product_price_id], references: [id])
  tenant                   Tenant    @relation("B2CUserProductAccess", fields: [tenant_id], references: [id], onDelete: Cascade)

  // Stripe identifiers (subscription OR payment)
  stripe_subscription_id   String?   @db.VarChar(100)  // For subscription modes
  stripe_customer_id       String    @db.VarChar(100)
  stripe_price_id          String    @db.VarChar(100)
  stripe_payment_intent_id String?   @db.VarChar(100)  // For one_time modes

  // Access control
  access_type              String    @db.VarChar(20)   // subscription | lifetime | temporary
  status                   String    @db.VarChar(50)   // active | expired | canceled | past_due

  // Subscription fields (for unlimited/limited)
  current_period_start     DateTime?
  current_period_end       DateTime?
  cancel_at_period_end     Boolean   @default(false)
  canceled_at              DateTime?
  trial_start              DateTime?
  trial_end                DateTime?

  // One-time payment fields (for one_time/one_time_exp)
  access_granted_at        DateTime  @default(now())
  access_expires_at        DateTime? // null = lifetime, date = temporary

  // Billing cycle tracking (for limited mode)
  max_billing_cycles       Int?
  completed_billing_cycles Int       @default(0)

  // Financial
  amount                   Int       // cents
  currency                 String    @default("brl") @db.VarChar(3)

  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  @@unique([tenant_id, stripe_subscription_id])
  @@index([tenant_id])
  @@index([tenant_id, user_id, status])
  @@index([user_id, status])
  @@index([user_id, product_id, status])
  @@index([stripe_subscription_id])
  @@index([access_type, status])
  @@index([access_expires_at])
  @@map("b2c_user_product_access")
}

// ============================================
// B2B One-Time Payments Models
// ============================================

model B2BProduct {
  id                String   @id @default(cuid()) @db.VarChar(25)
  tenant_id         String   @db.VarChar(25)
  stripe_product_id String   @db.VarChar(100)
  stripe_price_id   String   @db.VarChar(100)
  name              String   @db.VarChar(255)
  description       String?  @db.Text
  categories        String[] @default([])
  price             Int      // Centavos
  currency          String   @default("brl") @db.VarChar(3)
  active            Boolean  @default(true)

  // Fee overrides — null = herda da categoria ou da taxa global do tenant
  category_id              String?  @db.VarChar(25)
  chip_cost_override       Float?                    // % override. null = herda
  shipping_fee_override    Int?                      // centavos override. null = herda
  requires_shipping        Boolean  @default(false)  // true para produtos físicos

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  tenant            Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category          ProductCategory? @relation("B2BProductCategory", fields: [category_id], references: [id], onDelete: SetNull)
  purchases         B2BPurchase[]

  @@unique([tenant_id, stripe_product_id])
  @@unique([tenant_id, stripe_price_id])
  @@index([tenant_id])
  @@index([tenant_id, active])
  @@index([tenant_id, category_id])
  @@map("b2b_products")
}

model B2BPurchase {
  id                      String    @id @default(cuid()) @db.VarChar(25)
  tenant_id               String    @db.VarChar(25)
  user_id                 String?   @db.VarChar(25)
  product_id              String    @db.VarChar(25)
  stripe_checkout_id      String?   @db.VarChar(200)
  stripe_payment_intent   String?   @db.VarChar(200)
  
  checkout_started_at     DateTime? @db.Timestamptz
  checkout_completed_at   DateTime? @db.Timestamptz
  checkout_abandoned_at   DateTime? @db.Timestamptz
  
  status                  String    @db.VarChar(20) // pending, completed, abandoned, refunded
  amount                  Int       // Centavos
  currency                String    @db.VarChar(3)
  
  customer_email          String    @db.VarChar(255)
  customer_name           String?   @db.VarChar(255)
  customer_phone          String?   @db.VarChar(50)
  
  metadata                Json?     @db.JsonB
  
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  tenant                  Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product                 B2BProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user                    User?      @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, stripe_checkout_id])
  @@unique([tenant_id, stripe_payment_intent])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([user_id])
  @@index([product_id])
  @@index([customer_email])
  @@index([created_at])
  @@map("b2b_purchases")
}
