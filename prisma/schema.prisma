// ============================================
// CMS - Generic Media Asset Management
// ============================================

model MediaCollection {
  id                 String   @id @default(cuid()) @db.VarChar(25)
  name               String   @db.VarChar(100)
  slug               String   @db.VarChar(100)
  description        String?  @db.Text
  type               String   @db.VarChar(20) // image, document, video, audio, mixed
  max_file_size      Int? // bytes
  allowed_mime_types String?  @db.Text // JSON array
  max_items          Int?
  tenant_id          String @db.VarChar(25)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  assets MediaAsset[]
  blogs  Blog[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@map("media_collections")
}

model MediaAsset {
  id            String   @id @default(cuid()) @db.VarChar(25)
  url           String   @db.VarChar(500)
  storage_key   String   @db.VarChar(500)
  filename      String   @db.VarChar(255)
  mime_type     String   @db.VarChar(100)
  file_size     Int
  width         Int?
  height        Int?
  alt_text      String?  @db.VarChar(255)
  metadata      Json? // Flexible metadata
  status        String   @default("ready") @db.VarChar(20)
  collection_id String   @db.VarChar(25)
  tenant_id     String @db.VarChar(25)
  created_by    String @db.VarChar(25)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  collection         MediaCollection      @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  relations          MediaAssetRelation[]
  LeadAttachment     LeadAttachment[]
  ArticleCoverImages Article[]            @relation("ArticleCoverImage")
  AuthorAvatars      Author[]             @relation("AuthorAvatar")

  @@index([collection_id])
  @@index([tenant_id])
  @@index([created_by])
  @@index([status])
  @@map("media_assets")
}

model MediaAssetRelation {
  id              String   @id @default(cuid()) @db.VarChar(25)
  asset_id        String   @db.VarChar(25)
  entity_type     String   @db.VarChar(50) // 'article', 'brand', 'company', etc.
  entity_id       String   @db.VarChar(50) // Polymorphic - can be Int or UUID
  entity_id_type  String   @db.VarChar(10) // 'int' or 'uuid'
  relation_type   String   @db.VarChar(50) // 'featured', 'gallery', 'attachment', 'avatar'
  display_order   Int?
  metadata        Json?
  created_at      DateTime @default(now())

  asset MediaAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, entity_type, entity_id, relation_type])
  @@index([entity_type, entity_id])
  @@index([asset_id])
  @@map("media_asset_relations")
}

model LeadAttachment {
  id         String      @id @default(cuid()) @db.VarChar(25)
  lead_id    String   @db.Uuid
  asset_id   String   @db.VarChar(25)
  label      String?  @db.VarChar(100)
