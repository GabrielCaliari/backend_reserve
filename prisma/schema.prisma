  encrypted_token  String             @db.Text
  refresh_token    String?            @db.Text
  token_expires_at DateTime?
  last_sync_at     DateTime?
  sync_status      EIntegrationStatus @default(PENDING)
  error_message    String?            @db.Text
  // IG Business Account ID the Graph API calls resolve against (platform:
  // INSTAGRAM only). Nullable because it's meaningless for GA4/META_ADS/GOOGLE_ADS
  // credentials — reusing HotelApiCredential per §3.4 needed one additive field.
  ig_user_id       String?            @db.VarChar(50)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  HotelClient      HotelClient        @relation(fields: [client_id], references: [id])

  @@unique([client_id, platform])
  @@index([client_id, sync_status])
  @@map("hotel_api_credentials")
